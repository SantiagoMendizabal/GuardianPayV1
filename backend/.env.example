# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS LOCAL (MYSQL WORKBENCH) - GUARDIANPAY
# ==============================================================================
# Instrucciones para tu compañero:
# 1. Copia este archivo y renómbralo como: .env
# 2. Cambia DB_USER y DB_PASSWORD con la contraseña de tu MySQL Workbench local.
# 3. Al iniciar el backend, la base de datos 'guardianpay_db' y sus 4 tablas 
#    se crearán automáticamente si no existen.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=admin123
DB_NAME=guardianpay_db

# Opcional: URL completa de conexión (por ejemplo para Supabase o Render)
# DATABASE_URL=mysql+pymysql://root:admin123@localhost:3306/guardianpay_db
